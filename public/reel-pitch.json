[{"t": 0.0, "text": "Welcome everyone, let's get started.", "kind": "anchor", "note": "anchor: intro"}, {"t": 5.0, "text": "Let me show you how it works. First you talk, then Bill listens, and then the slide appears.", "kind": "slide", "note": "PROCESS    0.6s", "slide": {"layout": "PROCESS", "headline": "how it works", "items": ["talk", "Bill listens", "the slide appears"], "mood": "funny", "claims_fact": false}}, {"t": 13.0, "text": "Here is what you get. No clicker, no slides to build, no stage fright, and pure improv.", "kind": "slide", "note": "CHECKLIST    0.5s", "slide": {"layout": "CHECKLIST", "headline": "improv talk setup", "body": "no clicker, no slides", "mood": "funny", "claims_fact": false, "items": ["No clicker", "no slides to build", "no stage fright", "pure improv"]}}, {"t": 21.0, "text": "We built it on four things. Voice, photos, GIFs, and charts.", "kind": "slide", "note": "ICON_GRID    0.5s", "slide": {"layout": "ICON_GRID", "headline": "four things", "items": ["Voice", "photos", "GIFs", "charts"], "icons": ["Atom", "Camera", "Gif", "ChartPie"], "mood": "funny", "claims_fact": false}}, {"t": 28.0, "text": "Eighty percent of our beta testers never opened a slide editor again.", "kind": "slide", "note": "CHART  chart {\"kind\": \"ring\", \"values\": [80], \"labels\": [\"never opened editor\"]}  0.4s", "slide": {"layout": "CHART", "headline": "beta tester drop-off", "chart": {"kind": "ring", "values": [80], "labels": ["never opened editor"]}, "claims_fact": false}}, {"t": 35.0, "text": "Now let's talk about the money.", "kind": "slide", "note": "TITLE_CARD    0.4s", "slide": {"layout": "TITLE_CARD", "headline": "the money", "mood": "funny", "claims_fact": false}}, {"t": 40.0, "text": "A full hour of talking costs us eleven dollars.", "kind": "slide", "note": "BIG_NUMBER  number eleven dollars (vibe)  0.5s", "slide": {"layout": "BIG_NUMBER", "headline": "eleven dollars", "body": "full hour of talking", "number": "eleven dollars", "mood": "funny", "claims_fact": false}}, {"t": 46.0, "text": "Our biggest competitor charges twenty dollars a month for a template.", "kind": "slide", "note": "VERSUS  eleven dollars vs twenty dollars a month [VIBE]  0.4s", "slide": {"layout": "VERSUS", "headline": "our price vs competitor", "versus": ["eleven dollars", "twenty dollars a month"], "mood": "funny", "claims_fact": true}}, {"t": 53.0, "text": "That is a joke, and we are the punchline.", "kind": "slide", "note": "MEME    0.6s", "slide": {"layout": "MEME", "headline": "That is a joke", "body": "and we are the punchline", "mood": "funny", "claims_fact": false}}, {"t": 58.0, "text": "Bill, cats or dogs", "kind": "slide", "note": "VERSUS  cats vs dogs  0.5s", "slide": {"layout": "VERSUS", "headline": "cats or dogs", "items": ["Cat", "Dog"], "icons": ["Cat", "Dog"], "mood": "funny", "claims_fact": false, "versus": ["cats", "dogs"]}}, {"t": 63.0, "text": "To get started, you need three steps. Sign up, connect your mic, and say hello.", "kind": "slide", "note": "PROCESS    0.5s", "slide": {"layout": "PROCESS", "headline": "onboarding steps", "body": "", "items": ["Sign up", "connect your mic", "say hello"], "mood": "hype", "claims_fact": false}}, {"t": 71.0, "text": "In the future we want to cover every stage in Europe.", "kind": "slide", "note": "TITLE_CARD    0.5s", "slide": {"layout": "TITLE_CARD", "headline": "future expansion", "mood": "hype", "claims_fact": false}}, {"t": 77.0, "text": "Thank you all, see you in the Discord.", "kind": "anchor", "note": "anchor: close"}]